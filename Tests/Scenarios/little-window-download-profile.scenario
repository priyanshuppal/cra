# A file downloaded in a Little Window is saved under the Little Window's profile. Its downloads went through the
# browser window with no tab, so they were recorded under the browser window's profile (Personal, on Default) even
# with the Little Window on Hobbies. Personal is on Default, Random on the profile Hobbies.
home
budget rss=700 stalls50=20

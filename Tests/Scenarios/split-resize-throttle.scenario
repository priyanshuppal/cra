# A dragged split divider moves the cards on every mouse move but resizes the page windows at most
# 30 times a second (PaneResizeThrottle), as Arc throttles its content resizes
# (WindowContentViewController's ContentResizeMode.throttle); Chromium lays a page out on every
# resize, ~5 ms a window. The frame it is let go at always reaches the pages.
budget stalls50=20
pace 0.5
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true}

cra://debug?windowSize=1200x800
cra://open?url=${PAGE}?n=left
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)
cra://open?url=${PAGE}?n=right
cra://open?url=${PAGE}?n=shown
wait 1
cra://debug?dropSplit=n=right&x=0.97&y=0.5
expect-log dropSplit: split horizontal n=shown \| n=right open=n=right shares=0\.50 0\.50$
wait 1
# Seven moves 4 ms apart, within 33 ms: the first resizes the pages, then the let-go, no more.
cra://debug?dividerDrag=40,2,-1,3,-60,1,80
expect-log dividerDrag: pageResizes=[12]$
wait 1
# A single move resizes them once, and the let-go owes nothing.
cra://debug?dividerDrag=-30
expect-log dividerDrag: pageResizes=1$

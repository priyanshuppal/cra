# Arc 1.174.3's split view ticks (a generic haptic, now) as a tab dragged over the page first
# offers a drop, and as the drop turns from a new pane to a pane's place (SplitViewController's
# dropHapticSubject), and as a dragged divider catches the 50/50 middle (PaneResizeState's
# isCenterSnapped). Cra's sidebar ticked for its own split target, its page and divider didn't.
budget stalls50=20
pace 0.5
seed settings.json {"hasSeenImportPrompt": true, "toolbarDefaultMigrated": true}

cra://debug?windowSize=1200x800
cra://open?url=${PAGE}?n=left
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)
cra://open?url=${PAGE}?n=other
cra://open?url=${PAGE}?n=right
cra://open?url=${PAGE}?n=shown
wait 1
cra://debug?haptics=reset
# The tab on screen offers nothing, so nothing ticks.
cra://debug?dropSplit=n=shown&x=0.97&y=0.5
expect-log dropSplit: none$
cra://debug?haptics=none
expect-log Cra haptics none: generic=0 alignment=0
# A drop region opening ticks once.
cra://debug?dropSplit=n=right&x=0.97&y=0.5
expect-log dropSplit: split horizontal n=shown \| n=right open=n=right shares=0\.50 0\.50$
cra://debug?haptics=region
expect-log Cra haptics region: generic=1 alignment=0
wait 1
# The divider from the middle: away, back into the middle (a tick), held there (none), out and
# back in (another), then let go away from it.
cra://debug?haptics=reset
cra://debug?dividerDrag=40,2,-1,3,-60,1,80
cra://debug?haptics=divider
expect-log Cra haptics divider: generic=2 alignment=0
wait 1
# A pane's ring, to take its place, ticks too.
cra://debug?haptics=reset
cra://debug?dropSplit=n=other&x=0.28&y=0.5
expect-log dropSplit: proposed replace 0 \(n=shown\)$
cra://debug?haptics=ring
expect-log Cra haptics ring: generic=1 alignment=0
